# LeadFlow configuration. Copy this file to .env.local (development) or provide the same variables to the server (production).
# .env.local is git-ignored: never commit real values.

# --- Bitrix24 -------------------------------------------------------------------------------------------------------

# demo (default): a built-in simulation answers instead of Bitrix24 and nothing leaves your server.
# live: leads go to your portal; needs BITRIX24_WEBHOOK_URL. Can also be switched in the admin panel (Settings).
BITRIX24_MODE=demo

# Inbound webhook of your portal: Developer resources -> Other -> Inbound webhook, grant the "CRM" permission.
# Format: https://<portal>.bitrix24.ru/rest/<user id>/<code>/
# A secret: read only on the server, never sent to the browser, masked in the sync journal.
BITRIX24_WEBHOOK_URL=

# Bearer token for /api/bitrix/* and /api/sync/run in live mode (they answer 401/503 without it).
# Generate a long random string, for example: openssl rand -hex 32
LEADFLOW_API_TOKEN=

# --- Sign-in to the admin panel -------------------------------------------------------------------------------------

# Secret that signs session cookies: at least 16 random characters. REQUIRED in production, otherwise nobody can sign in.
# Changing it signs everybody out. Generate one, for example: openssl rand -hex 32
LEADFLOW_SESSION_SECRET=

# Password of the first administrator (admin@example.com). Applied only when the database is created, so change the
# password later in the app, not here. REQUIRED in production: without it no account is created.
# Outside production an empty value falls back to the demo password "leadflow-demo".
LEADFLOW_ADMIN_PASSWORD=

# --- Database -------------------------------------------------------------------------------------------------------

# Local / Docker: SQLite file, created with its schema on first start. Put it on a persistent disk or volume.
LEADFLOW_DB_PATH=data/leadflow.db

# Vercel (no persistent disk): a remote libSQL database, e.g. Turso (turso db create / turso db tokens create).
# When LEADFLOW_DB_URL is set it wins over LEADFLOW_DB_PATH. A file database on Vercel is refused at startup.
LEADFLOW_DB_URL=
LEADFLOW_DB_TOKEN=

# Vercel Cron sends this as "Authorization: Bearer ..." to /api/sync/run (retries of failed syncs).
# Set it in the Vercel project; Vercel adds the header itself. Same strength as LEADFLOW_API_TOKEN.
CRON_SECRET=

# --- Demo stand (optional; leave empty on a real installation) -----------------------------------------------------

# true: fill an empty database with fictional demo leads (flagged "демо-запись"), as `npm run demo` does.
LEADFLOW_DEMO=

# With LEADFLOW_DEMO=true: password of the demo managers olga@, denis@, marina@example.com (and their rules).
# Demo managers are created only when this is set.
LEADFLOW_DEMO_PASSWORD=

# true: the login page lists the demo accounts and this password. Only for a public demo stand with fictional data.
LEADFLOW_SHOW_DEMO_LOGINS=
